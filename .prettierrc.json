{
  "$schema": "https://json.schemastore.org/prettierrc",
  "semi": true,
  "useTabs": false,
  "tabWidth": 4,
  "singleQuote": false,
  "printWidth": 100,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": false,
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["*.scss", "*.json"],
      "options": {
        "tabWidth": 2
      }
    }
  ]
}
