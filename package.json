{
  "name": "workflow-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.2.1",
  "type": "module",
  "scripts": {
    "dev:local": "vite",
    "dev": "pnpm --parallel dev:local",
    "build": "pnpm --filter @uva-fnwi/datanose-ui build && pnpm --filter @uva-fnwi/datanose-core build && tsc -b && vite build",
    "build:ui": "pnpm --filter @uva-fnwi/datanose-ui build",
    "build:core": "pnpm --filter @uva-fnwi/datanose-core build",
    "build:all": "pnpm build:core && pnpm build:ui",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "translations:check": "i18next-cli extract --ci",
    "translations:generate": "i18next-cli extract",
    "preview": "vite preview",
    "prepare": "husky",
    "test": "pnpm --filter @uva-fnwi/datanose-ui build && vitest run",
    "test:watch": "vitest",
    "e2e-test": "playwright test",
    "dev:mock-api": "tsx tests/dummy-api.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@uiw/react-codemirror": "^4.25.11",
    "@uva-fnwi/datanose-core": "workspace:*",
    "@uva-fnwi/datanose-ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "date-fns": "^4.1.0",
    "exceljs": "^4.4.0",
    "i18next": "^25.10.10",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^3.0.6",
    "lodash-es": "^4.18.1",
    "papaparse": "^5.6.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.74.0",
    "react-i18next": "^16.6.6",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.2.0",
    "react-router": "^7.14.2",
    "react-stately": "^3.46.0",
    "rehype-raw": "^7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.12.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "express": "^5.2.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.56.9",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^7.3.2",
    "vitest": "^4.1.9"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,css,md}": "prettier --write"
  }
}
