{
  "name": "workflow-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:local": "concurrently \"pnpm run translations:types -w\" \"vite\"",
    "dev": "pnpm --parallel dev:local",
    "build": "pnpm --filter @datanose/ui build && tsc -b && vite build",
    "build:ui": "pnpm --filter @datanose/ui build",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "translations:check": "i18next-cli extract --ci",
    "translations:generate": "i18next-cli extract",
    "translations:types": "i18next-cli types",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@datanose/ui": "workspace:*",
    "@reduxjs/toolkit": "^2.2.7",
    "@tanstack/match-sorter-utils": "^8.19.4",
    "@tanstack/react-table": "^8.21.3",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "date-fns": "^4.1.0",
    "i18next": "^25.6.2",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "lodash-es": "^4.17.21",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.66.0",
    "react-i18next": "^16.5.1",
    "react-redux": "^9.1.2",
    "react-router": "^7.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.16",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "i18next-cli": "^1.34.0",
    "lint-staged": "^16.2.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --cache --fix",
    "*.{ts,tsx,css,md}": "prettier --write"
  }
}
